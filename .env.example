# ─── Banco ───────────────────────────────────────────────────────────────────
# SQLite: o banco é um arquivo, não um serviço. Escolhido para não pagar um
# segundo serviço no Railway. Plugin `sqlite-database-integration`, feature
# plugin do time de Performance do WordPress, ainda marcado "Under Development".
DB_ENGINE='sqlite'

# 🔴 Em container, DB_DIR PRECISA apontar para dentro do volume. O padrão do
# plugin é web/app/database/, que vive na imagem: cada deploy subiria um site
# em branco, sem erro nenhum. Local pode deixar comentado.
#   Railway: DB_DIR='/data/database/'
# DB_DIR=''
# DB_FILE='.ht.sqlite'

# ─── Para voltar a MySQL/MariaDB ─────────────────────────────────────────────
# Troque DB_ENGINE acima para 'mysql' e preencha abaixo. É o caminho de saída se
# o SQLite apertar (ou se precisar de mais de uma réplica): a migração usa
# `wp db export` no SQLite e import no MySQL.
# DB_NAME='alab_wp'
# DB_USER='alab'
# DB_PASSWORD='trocar'
# DB_HOST='127.0.0.1:3307'
# DATABASE_URL='mysql://usuario:senha@host:porta/banco'

# Prefixo default é `wp_`. Só mude se houver motivo.
# DB_PREFIX='wp_'

# `production` é o default do Bedrock quando WP_ENV não é definido.
# É WP_ENV que decide a indexação — `blog_public` do banco nunca é lido.
WP_ENV='development'

# ⚠️ Em produção, WP_HOME é o caminho público servido pela Vercel, não o
# hostname da origem. O rewrite do `alab-lp/vercel.json` entrega /blog/* para
# cá; se WP_HOME apontar para a origem, o WordPress emite URLs absolutas dela e
# vaza o hostname do Railway.
#   produção: WP_HOME='https://alabventure.com/blog'
WP_HOME='http://localhost:8080'

# ⚠️ WP_SITEURL termina em /wp e NÃO é igual a WP_HOME. No Bedrock o core vive
# em web/wp; igualando os dois, o WordPress emite /blog/wp-includes/ e
# /blog/wp-admin/, que dão 404 — todo asset do core quebra e o admin some.
WP_SITEURL="${WP_HOME}/wp"

# Raiz da landing. O tema linka de volta para lá pelos tokens {{APP_URL}} das
# partes. Vazio = caminho absoluto de raiz, correto em produção porque o blog
# vive em /blog do mesmo domínio.
# ⚠️ Em desenvolvimento o WordPress É a raiz, então esses links dão 404 do
# próprio WordPress. Aponte para a landing rodando se quiser testá-los.
#   produção:        ALAB_APP_URL=''
#   desenvolvimento: ALAB_APP_URL='http://localhost:8000'
# ALAB_APP_URL=''

# Idioma do site. Os arquivos .mo do locale vêm na imagem (o Dockerfile os
# baixa no build), e o entrypoint aponta a opção WPLANG do banco na primeira
# subida em que ela estiver vazia.
#
# ⚠️ Definir WPLANG aqui ou no wp-config NÃO tem efeito: `get_locale()` lê a
# opção do banco com `false !== $db_locale`, e a opção existe desde a
# instalação com valor vazio — ela sobrescreve a constante e volta para en_US.
ALAB_LOCALE='pt_BR'

# Fuso. Decisão declarada, não derivada do idioma — o default do WordPress é
# UTC, e sem isto a hora de publicação de todo post sai três horas adiantada.
ALAB_TIMEZONE='America/Sao_Paulo'

# WP_DEBUG_LOG='/caminho/para/debug.log'

# Gerar em https://roots.io/salts.html — valores DISTINTOS por ambiente.
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'
